{
  "name": "rung",
  "version": "0.1.0",
  "description": "Privacy preserving compensation surveys on Midnight",
  "author": "Can Sar\u0131han",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "cli",
    "web"
  ],
  "scripts": {
    "compact": "npm run compact --workspace contract",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run deploy --workspace cli",
    "proof-server": "docker run --rm -p 6300:6300 midnightntwrk/proof-server:8.1.0 midnight-proof-server -v",
    "dev": "npm run dev --workspace web"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
