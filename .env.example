# Target network: preprod or preview
RUNG_NETWORK=preprod

# 32 byte hex seed for the wallet that pays deployment and report fees.
# Leave unset to have the CLI generate and print one on first run.
RUNG_WALLET_SEED=

# Local proof server. Start it with: npm run proof-server
RUNG_PROOF_SERVER=http://127.0.0.1:6300

# Band scale used when deploying a new survey.
RUNG_BAND_WIDTH=10000
RUNG_BAND_COUNT=12
RUNG_CURRENCY=$
